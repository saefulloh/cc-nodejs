Nodejs - ExpressJS
git clone -b rds https://github.com/saefulloh/cc-nodejs.git

install nodejs dan npm
Atur konfigurasi koneksi ke RDS di file index.js
jalankan command npm install untuk mendownload library atau node module
jalankan comand node index.js untuk menjalankan service rest api siswa

CREATE DATABASE `sekolah`;

CREATE TABLE siswa (
    id INT AUTO_INCREMENT PRIMARY KEY,
    no_induk_siswa VARCHAR(50) NOT NULL,
    nama VARCHAR(100) NOT NULL,
    alamat TEXT,
    tanggal_lahir DATE
);

INSERT INTO `sekolah`.`siswa` (`no_induk_siswa`, `nama`, `alamat`, `tanggal_lahir`) VALUES ('001', 'Rifai', 'Bondolharjo', '1996-04-30');
INSERT INTO `sekolah`.`siswa` (`no_induk_siswa`, `nama`, `alamat`, `tanggal_lahir`) VALUES ('002', 'Fauzan', 'Banjarnegara', '1990-03-10');


Setelah setup codingan di server ec2 akses api 

GET {endpoint.domain.serverec2}/siswa

