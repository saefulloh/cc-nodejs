CURL untuk testing

curl http://localhost:3000/siswa

curl http://localhost:3000/siswa/1

curl -X POST http://localhost:3000/siswa \
  -H "Content-Type: application/json" \
  -d '{
    "no_induk_siswa": "12345",
    "nama": "Andi Saputra",
    "alamat": "Jl. Merdeka No.10",
    "tanggal_lahir": "2005-08-15"
}'

curl -X PUT http://localhost:3000/siswa/1 \
  -H "Content-Type: application/json" \
  -d '{
    "no_induk_siswa": "12345",
    "nama": "Andi S.",
    "alamat": "Jl. Sudirman",
    "tanggal_lahir": "2005-08-15"
}'

curl -X DELETE http://localhost:3000/siswa/1


