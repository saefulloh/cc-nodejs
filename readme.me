CREATE DATABASE `sekolah`;

CREATE TABLE siswa (
    id INT AUTO_INCREMENT PRIMARY KEY,
    no_induk_siswa VARCHAR(50) NOT NULL,
    nama VARCHAR(100) NOT NULL,
    alamat TEXT,
    tanggal_lahir DATE
);

